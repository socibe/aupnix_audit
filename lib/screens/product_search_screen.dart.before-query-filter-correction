class _SearchProduct {
  const _SearchProduct({
    required this.name,
    required this.unit,
    required this.price,
    required this.image,
    required this.availability,
    required this.store,
    required this.category,
  });

  final String name;
  final String unit;
  final int price;
  final String image;
  final String availability;
  final String store;
  final String category;

  double get distanceKm {
    switch (store) {
      case 'Croma - HSR Layout':
        return 1.2;
      case 'Star Market':
        return 2.1;
      case 'Reliance Smart':
        return 3.4;
      case 'More Megastore':
        return 4.7;
      default:
        return 9.9;
    }
  }

  bool get isOpen {
    switch (store) {
      case 'Croma - HSR Layout':
        return true;
      case 'Star Market':
        return true;
      case 'Reliance Smart':
        return false;
      case 'More Megastore':
        return true;
      default:
        return false;
    }
  }
}

